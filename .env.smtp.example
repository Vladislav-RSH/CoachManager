# Copy this file to .env.smtp.local and fill the values.
# Do not commit .env.smtp.local. Files ending with .local are already ignored.

# Supabase account access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Supabase project ref, for example abcdefghijklmnopqrst from https://<ref>.supabase.co
# You can also leave this empty if VITE_SUPABASE_URL is present in .env.local.
SUPABASE_PROJECT_REF=

# Resend SMTP credentials.
# SMTP host: smtp.resend.com
# SMTP port: 465
# SMTP username: resend
RESEND_SMTP_PASSWORD=

# Sender identity. The domain must be verified in Resend.
SMTP_FROM_EMAIL=no-reply@your-domain.com
SMTP_FROM_NAME=Tempo
